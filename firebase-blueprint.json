{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user name, role, photo, and system settings.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photo": { "type": "string", "description": "URL or base64 of user photo" },
        "role": { "type": "string" },
        "settings": {
          "type": "object",
          "properties": {
            "notificationsEmail": { "type": "boolean" },
            "notificationsPush": { "type": "boolean" },
            "twoFactorAuth": { "type": "boolean" },
            "autoOptimize": { "type": "boolean" },
            "darkMode": { "type": "boolean" },
            "language": { "type": "string", "enum": ["fr", "en"] }
          },
          "required": ["notificationsEmail", "notificationsPush", "twoFactorAuth", "autoOptimize", "darkMode", "language"]
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "photo", "role", "settings", "updatedAt"]
    },
    "Building": {
      "title": "Building",
      "description": "Represents an energy-managed building/site.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string", "enum": ["OPTIMAL", "ALERTE", "ATTENTION", "NORMAL"] },
        "consumption": { "type": "string", "description": "formatted string e.g. '12,450 kWh'" },
        "economy": { "type": "string" },
        "trend": { "type": "string" },
        "surface": { "type": "string" },
        "occupancy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "location", "status", "consumption"]
    },
    "PlanningIntervention": {
      "title": "Planning Intervention",
      "description": "Represents a scheduled maintenance or intervention on equipment or building in the planning collection.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "buildingId": { "type": "string", "maxLength": 100 },
        "buildingName": { "type": "string", "maxLength": 200 },
        "location": { "type": "string", "maxLength": 200 },
        "date": { "type": "string", "maxLength": 50 },
        "startHour": { "type": "number" },
        "endHour": { "type": "number" },
        "startTimeStr": { "type": "string", "maxLength": 20 },
        "endTimeStr": { "type": "string", "maxLength": 20 },
        "category": { "type": "string", "maxLength": 50 },
        "technicianIds": { "type": "array" },
        "status": { "type": "string", "enum": ["planned", "in_progress", "completed", "urgent", "cancelled"] },
        "notes": { "type": "string", "maxLength": 1000 },
        "priority": { "type": "string", "enum": ["normal", "high", "critical"] },
        "rsvpStatus": { "type": "string", "enum": ["pending", "confirmed", "declined"] },
        "source": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "buildingId", "date", "startHour", "endHour", "category", "technicianIds", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and settings, secured by userId."
    },
    "/users/{userId}/buildings/{buildingId}": {
      "schema": "Building",
      "description": "User-specific buildings portfolio."
    },
    "/planning/{interventionId}": {
      "schema": "PlanningIntervention",
      "description": "Scheduled interventions and maintenances synchronized across application database."
    }
  }
}
